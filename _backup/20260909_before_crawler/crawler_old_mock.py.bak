# -*- coding: utf-8 -*-
"""
静岡県の実在イベント情報を「くふうロコ しずおか」(https://loco.kufu.jp/shizuoka/events)
から取得し、events.db の item_type='event' の行を実データで置き換えるクローラー。

くふうロコは静岡県内の実在イベントを継続的に更新している地域情報サイトで、
robots.txt でクロールが許可されている(Allow: /、/_next/ のみ除外)。
Next.js の __NEXT_DATA__ に構造化データが埋め込まれているため、
HTMLではなくそのJSONを直接パースする。

item_type='spot' / 'gourmet' の行(実在の定番スポット・グルメ、id 4-9)は対象外。
このスクリプトは手動実行を想定している(スケジューリングは未実装)。

実行方法: python crawler.py
"""
import json
import re
import sqlite3
import time
import urllib.parse
import urllib.request

DB_PATH = "events.db"
BASE_URL = "https://loco.kufu.jp/shizuoka/events"
USER_AGENT = "ShizuokaEventNaviBot/1.0 (personal project; manual run; contact: junk.ya.san@gmail.com)"
SOURCE_NAME = "くふうロコ しずおか"

WEEKDAY_JP = ["月", "火", "水", "木", "金", "土", "日"]

# 市区町村ごとの概算座標(ジオコーディング失敗時のフォールバック用)
CITY_FALLBACK_COORDS = {
    "静岡市": (34.9756, 138.3827), "浜松市": (34.7108, 137.7261),
    "沼津市": (35.0958, 138.8636), "熱海市": (35.0955, 139.0717),
    "伊東市": (34.9695, 139.1017), "富士市": (35.1615, 138.6759),
    "富士宮市": (35.2229, 138.6203), "御殿場市": (35.3068, 138.9351),
    "焼津市": (34.8768, 138.3204), "掛川市": (34.7686, 138.0128),
    "磐田市": (34.7169, 137.8497), "三島市": (35.1186, 138.9182),
    "藤枝市": (34.8667, 138.2536), "伊豆市": (34.9773, 138.9425),
    "袋井市": (34.7502, 137.9202), "下田市": (34.6774, 138.9486),
    "島田市": (34.8367, 138.1758), "裾野市": (35.1734, 138.9037),
    "牧之原市": (34.7091, 138.2278), "菊川市": (34.7573, 138.0834),
    "御前崎市": (34.6362, 138.1265), "湖西市": (34.7333, 137.5199),
    "伊豆の国市": (35.0400, 138.9450), "西伊豆町": (34.7692, 138.7942),
    "松崎町": (34.7381, 138.7817), "河津町": (34.8112, 138.9464),
    "東伊豆町": (34.8871, 139.0578), "南伊豆町": (34.6299, 138.8460),
    "函南町": (35.1197, 138.9633), "清水町": (35.1103, 138.9081),
    "長泉町": (35.1497, 138.9106), "小山町": (35.3453, 138.9298),
    "森町": (34.8155, 137.9251), "川根本町": (35.0797, 138.1394),
}
DEFAULT_COORDS = (34.9769, 138.3831)  # 静岡県庁付近

CITY_RE = re.compile(r"(?:静岡県)?(?:[^\s\d]*郡)?(.+?[市町村])")


def fetch_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=20) as resp:
        html = resp.read().decode("utf-8")
    m = re.search(r'<script id="__NEXT_DATA__"[^>]*>(.*?)</script>', html, re.S)
    if not m:
        raise RuntimeError(f"__NEXT_DATA__ not found at {url}")
    return json.loads(m.group(1))


def fetch_all_events():
    events = []
    seen_ids = set()
    page = 1
    while True:
        url = f"{BASE_URL}?page={page}"
        data = fetch_json(url)
        dh = data["props"]["pageProps"]["dehydratedState"]
        query = dh["queries"][0]
        page_data = query["state"]["data"]["pages"][0]
        page_events = page_data["events"]
        info = page_data["pageInfo"]

        for e in page_events:
            if e["id"] not in seen_ids:
                seen_ids.add(e["id"])
                events.append(e)

        total_pages = -(-info["totalCount"] // info["itemSize"])  # 切り上げ
        print(f"  page {page}/{total_pages}: {len(page_events)}件 (累計 {len(events)}件)")
        if page >= total_pages:
            break
        page += 1
        time.sleep(0.8)  # 相手サーバーへの配慮
    return events


def extract_city(address):
    m = CITY_RE.match(address)
    return m.group(1) if m else ""


def format_date_str(date_entry):
    start = date_entry.get("startDate")
    end = date_entry.get("endDate")
    start_time = date_entry.get("startTime")
    end_time = date_entry.get("endTime")

    def to_jp(iso_date):
        y, mo, d = iso_date.split("-")
        import datetime
        wd = WEEKDAY_JP[datetime.date(int(y), int(mo), int(d)).weekday()]
        return int(y), int(mo), int(d), wd

    sy, sm, sd, swd = to_jp(start)
    s = f"{sy}年{sm}月{sd}日({swd})"

    if end and end != start:
        ey, em, ed, ewd = to_jp(end)
        if ey == sy:
            s += f" 〜 {em}月{ed}日({ewd})"
        else:
            s += f" 〜 {ey}年{em}月{ed}日({ewd})"

    if start_time and end_time:
        st = start_time[11:16]
        et = end_time[11:16]
        s += f" {st}〜{et}"

    return s


_geocode_cache = {}


def geocode(address, city):
    if address in _geocode_cache:
        return _geocode_cache[address]

    candidates = [address]
    stripped = re.sub(r"[0-9０-９\-−ー]+[0-9０-９\-−ー\s]*$", "", address).strip()
    if stripped and stripped != address:
        candidates.append(stripped)

    result = None
    for q in candidates:
        try:
            params = urllib.parse.urlencode({
                "q": q, "format": "json", "limit": 1, "countrycodes": "jp",
            })
            req = urllib.request.Request(
                f"https://nominatim.openstreetmap.org/search?{params}",
                headers={"User-Agent": USER_AGENT},
            )
            with urllib.request.urlopen(req, timeout=15) as resp:
                data = json.loads(resp.read().decode("utf-8"))
            time.sleep(1.1)  # Nominatimの利用ポリシー(1req/秒以下)を厳守
            if data:
                result = (float(data[0]["lat"]), float(data[0]["lon"]))
                break
        except Exception as exc:
            print(f"  [geocode error] {q}: {exc}")
            time.sleep(1.1)

    if result is None:
        result = CITY_FALLBACK_COORDS.get(city, DEFAULT_COORDS)

    _geocode_cache[address] = result
    return result


def transform(e):
    city = extract_city(e["address"]) or ""
    lat, lng = geocode(e["address"], city)

    dates = e.get("dates") or []
    date_str = format_date_str(dates[0]) if dates else "日程は公式サイトをご確認ください"

    summary = e.get("catchCopy") or (e.get("description") or "")[:70]
    description = (e.get("description") or "").strip()

    fee = "入場無料" if e.get("isBudgetFree") else "有料（詳細は公式サイトをご確認ください）"
    if e.get("hasTicket"):
        fee += "・要チケット"

    organizer = e.get("organizer") or ""

    return {
        "item_type": "event",
        "title": e["name"],
        "date_str": date_str,
        "location": e.get("facilityName") or "",
        "city": city,
        "address": e.get("address") or "",
        "lat": lat,
        "lng": lng,
        "google_maps_url": f"https://maps.google.com/?q={lat},{lng}",
        "official_url": f"{BASE_URL}/{e['id']}",
        "tags": e.get("genreName") or "",
        "summary": summary,
        "description": description,
        "image_url": e.get("mainImageUrl") or "",
        "fee": fee,
        "organizer": organizer,
        "parking_info": "情報なし（公式サイトをご確認ください）",
        "target_age": "情報なし",
        "is_free_parking": 0,
        "is_stroller_ok": 0,
        "is_rainy_ok": 0,
        "category_scene": "",
    }


def save_to_db(items):
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()

    cur.execute("DELETE FROM events WHERE item_type = 'event'")
    deleted = cur.rowcount
    print(f"既存の event 行を {deleted} 件削除しました。")

    cur.executemany("""
        INSERT INTO events (
            item_type, title, date_str, location, city, address, lat, lng, google_maps_url, official_url,
            tags, summary, description, image_url, fee, organizer, parking_info, target_age,
            is_free_parking, is_stroller_ok, is_rainy_ok, category_scene
        )
        VALUES (
            :item_type, :title, :date_str, :location, :city, :address, :lat, :lng, :google_maps_url, :official_url,
            :tags, :summary, :description, :image_url, :fee, :organizer, :parking_info, :target_age,
            :is_free_parking, :is_stroller_ok, :is_rainy_ok, :category_scene
        )
    """, items)

    conn.commit()
    conn.close()
    print(f"実イベント {len(items)} 件を登録しました。")


def main():
    print(f"'{SOURCE_NAME}' からイベント情報を取得します...")
    raw_events = fetch_all_events()
    print(f"合計 {len(raw_events)} 件の実イベントを取得しました。座標を解決しています...")

    items = []
    for i, e in enumerate(raw_events, 1):
        items.append(transform(e))
        if i % 10 == 0:
            print(f"  {i}/{len(raw_events)} 件処理済み")

    save_to_db(items)
    print("完了しました。")


if __name__ == "__main__":
    main()
